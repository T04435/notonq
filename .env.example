# Server-only. Each value is your own key; never commit real values.
# Qloo hackathon key (valid only on https://hackathon.api.qloo.com)
QLOO_API_KEY=
# Optional: Last.fm API key (non-commercial use), enables similar artists and listener counts
LASTFM_API_KEY=
# Optional: real Qloo calls allowed per caller per UTC day (cache hits are free; 0 = no limit). Default 1500.
NOTONQ_QLOO_DAILY_BUDGET=
# Deployed: a long random string for hashing caller keys in the Ledger (keys themselves are never stored)
NOTONQ_SALT=
# Neon: set by the Vercel Neon integration when deployed; locally the dev branch (.env.development.local, from HQ)
DATABASE_URL=
# Live Ledger (Neon Realtime; the branch's Realtime settings). Without them the Ledger isn't live.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
